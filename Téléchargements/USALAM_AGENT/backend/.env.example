# Server Configuration
PORT=3001
NODE_ENV=development

# Database (MongoDB - Legacy)
MONGODB_URI=mongodb://localhost:27017/usalama
MONGODB_TEST_URI=mongodb://localhost:27017/usalama_test

# Database (PostgreSQL + PostGIS - New)
DATABASE_URL=postgresql://usalama:usalama_secret@localhost:5432/usalama
DATABASE_USER=usalama
DATABASE_PASSWORD=usalama_secret
DATABASE_NAME=usalama
DATABASE_PORT=5432
DATABASE_HOST=localhost

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@usalama.cd

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# External Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
OPENWEATHER_API_KEY=your-openweather-api-key
PUSH_NOTIFICATION_KEY=your-push-notification-key

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Emergency Services
POLICE_PHONE=112
AMBULANCE_PHONE=999
FIRE_DEPARTMENT_PHONE=118

# Geolocation
DEFAULT_LAT=-4.4419
DEFAULT_LNG=15.2663
SEARCH_RADIUS_KM=50

# Analytics
ANALYTICS_ENABLED=true
DATA_RETENTION_DAYS=365

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
